# Google Gemini (optional — enables the AI evaluation)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=90

# MongoDB Atlas (optional — enables accounts + synced history)
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=papermatch
MONGODB_TIMEOUT_MS=10000

# Secret used to sign auth tokens — set a long random value
JWT_SECRET=change-me

# RAG tuning (usually no need to change)
RETRIEVAL_TOP_K=6
MISS_MATCH_THRESHOLD=0.45
EXTRA_SLIDE_THRESHOLD=0.35
